# HINLINK H28K 自定义 ImageBuilder 构建配置
#
# 这个文件只用于“源码构建自定义 ImageBuilder”。
# 目标：在官方 ImmortalWrt rockchip/armv8 release buildinfo 基础上，仅追加 H28K 设备，
# 尽量保持 kernel ABI / vermagic 与官方一致。
#
# 不要在这里加入 luci-app、主题、USB WiFi kmod 等最终固件软件包；
# 那些包放到 config/h28k-firmware.packages，由 ImageBuilder 生成固件阶段安装。

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# H28K 是补丁新增的设备，官方 config.buildinfo 没有这个 profile。
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_h28k=y
CONFIG_TARGET_DEVICE_PACKAGES_rockchip_armv8_DEVICE_hinlink_h28k=""

# 兼容部分 OpenWrt/ImmortalWrt 旧式 target profile 符号。
# workflow 会在 make defconfig 后自动检查 H28K profile 是否生效。
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_h28k=y

# 只需要生成 ImageBuilder；最终固件软件包和 kmod-* 由 ImageBuilder 阶段从官方仓库安装。
CONFIG_IB=y