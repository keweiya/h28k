CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_h28k=y
# luci-app-nikki / luci-theme-fluent 已移出阶段 1（官方源没有这两个包）：
# 它们由「构建插件包」工作流用 SDK 单独编译，阶段 2 组装固件时注入，
# 因此这里不再选择，避免阶段 1 构建因缺少源码而失败
CONFIG_PACKAGE_kmod-mt7921u=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
# 根目录大小由 config/firmware.conf 的 rootfs_size 控制（工作流输入可临时覆盖），不要在这里配置
# 以下为额外的镜像产物，均为镜像组装选项，不影响内核与 ABI：
# ext4 根目录固件变体（是否产出取决于 rockchip 配方，官方历来只发 squashfs，实测为准）
CONFIG_TARGET_ROOTFS_EXT4FS=y
# 根目录 tar 包（不含内核），可直接用于 LXC/容器，仅阶段 1 产出
CONFIG_TARGET_ROOTFS_TARGZ=y

# 构建完成后顺带产出自建 ImageBuilder（make imagebuilder），供快速定制构建使用
# 这是构建系统选项，不影响内核配置与 ABI
CONFIG_IB=y

# 编译缓存（ccache，官方 buildbot 同款机制）：配合 workflow 的 actions/cache
# 跨构建持久化 source/.ccache，同版本重跑与失败重试显著提速；缓存目录已在
# workflow 中限制为 CCACHE_MAXSIZE=2G。这是构建系统选项，不影响 ABI
CONFIG_CCACHE=y
