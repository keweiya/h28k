# 官方源常用 LuCI 插件开关清单（人工精选自官方全部 166 个插件，配对中文包）
# 用法：=y 安装进固件，=n 不安装；启用插件时建议把它配对的 luci-i18n-*-zh-cn 一并改为 =y（中文界面）
# 移除官方默认自带的包：行首加 -（如 -uhttpd），从默认包集中剔除；清单内未启用的包无需此语法（保持 =n 即可）
# 没有列出的冷门插件：完整目录可用 scripts/fetch_official_packages.sh 生成后查找
# 源码第三方插件（nikki 等）见 config/source-plugins.list；kmod/base 包在文件末尾"清单外"小节

# === 中文界面（默认开启）===
luci-i18n-base-zh-cn=y

# === 科学上网（ImmortalWrt 官方源内置的代理工具） ===
luci-app-homeproxy=n
luci-i18n-homeproxy-zh-cn=n
luci-app-passwall=n
luci-i18n-passwall-zh-cn=n
luci-app-openclash=y
luci-app-v2raya=n
luci-i18n-v2raya-zh-cn=n
luci-app-dae=n
luci-i18n-dae-zh-cn=n
luci-app-daed=n
luci-i18n-daed-zh-cn=n
luci-app-gost=n
luci-i18n-gost-zh-cn=n
luci-app-privoxy=n
luci-i18n-privoxy-zh-cn=n
luci-app-unblockneteasemusic=n

# === 文件共享 / NAS ===
luci-app-samba4=n
luci-i18n-samba4-zh-cn=n
luci-app-ksmbd=n
luci-i18n-ksmbd-zh-cn=n
luci-app-nfs=n
luci-i18n-nfs-zh-cn=n
luci-app-minidlna=n
luci-i18n-minidlna-zh-cn=n
luci-app-vsftpd=n
luci-i18n-vsftpd-zh-cn=n
luci-app-syncthing=n
luci-i18n-syncthing-zh-cn=n
luci-app-dufs=n
luci-i18n-dufs-zh-cn=n
luci-app-filebrowser=n
luci-i18n-filebrowser-zh-cn=n

# === 下载 / 离线 ===
luci-app-qbittorrent=n
luci-i18n-qbittorrent-zh-cn=n
luci-app-transmission=n
luci-i18n-transmission-zh-cn=n
luci-app-aria2=n
luci-i18n-aria2-zh-cn=n
luci-app-rclone=n
luci-i18n-rclone-zh-cn=n
luci-app-cloudflared=n
luci-i18n-cloudflared-zh-cn=n

# === Docker / 容器 ===
luci-app-docker=n
luci-i18n-docker-zh-cn=n
luci-app-dockerman=y
luci-i18n-dockerman-zh-cn=y
luci-app-lxc=n
luci-i18n-lxc-zh-cn=n

# === 内网穿透 / 远程 ===
luci-app-frpc=n
luci-i18n-frpc-zh-cn=n
luci-app-frps=n
luci-i18n-frps-zh-cn=n
luci-app-n2n=n
luci-i18n-n2n-zh-cn=n
luci-app-zerotier=n
luci-i18n-zerotier-zh-cn=n
luci-app-ttyd=y
luci-i18n-ttyd-zh-cn=y
luci-app-rustdesk-server=n
luci-i18n-rustdesk-server-zh-cn=n

# === VPN 服务 ===
luci-app-openvpn=n
luci-i18n-openvpn-zh-cn=n
luci-app-openvpn-server=n
luci-i18n-openvpn-server-zh-cn=n
luci-app-ipsec-vpnd=n
luci-i18n-ipsec-vpnd-zh-cn=n
luci-app-ocserv=n
luci-i18n-ocserv-zh-cn=n
luci-app-strongswan-swanctl=n

# === 网络优化 / 去广告 / 多线 ===
luci-app-upnp=n
luci-i18n-upnp-zh-cn=n
luci-app-sqm=n
luci-i18n-sqm-zh-cn=n
luci-app-qos=n
luci-i18n-qos-zh-cn=n
luci-app-nft-qos=n
luci-i18n-nft-qos-zh-cn=n
luci-app-eqos=n
luci-i18n-eqos-zh-cn=n
luci-app-pbr=n
luci-i18n-pbr-zh-cn=n
luci-app-mwan3=n
luci-i18n-mwan3-zh-cn=n
luci-app-banip=n
luci-i18n-banip-zh-cn=n
luci-app-adblock-fast=n
luci-i18n-adblock-fast-zh-cn=n
luci-app-adblock=n
luci-i18n-adblock-zh-cn=n
luci-app-adguardhome=y
luci-app-appfilter=n
luci-i18n-appfilter-zh-cn=n
luci-app-smartdns=n
luci-i18n-smartdns-zh-cn=n
luci-app-https-dns-proxy=n
luci-i18n-https-dns-proxy-zh-cn=n
luci-app-nextdns=n
luci-i18n-nextdns-zh-cn=n
luci-app-irqbalance=n
luci-i18n-irqbalance-zh-cn=n
luci-app-cpufreq=n
luci-i18n-cpufreq-zh-cn=n

# === 无线 ===
luci-app-travelmate=n
luci-i18n-travelmate-zh-cn=n
luci-app-wifischedule=n
luci-i18n-wifischedule-zh-cn=n
luci-app-usteer=n
luci-i18n-usteer-zh-cn=n
luci-app-dawn=n
luci-i18n-dawn-zh-cn=n

# === Web 服务器 ===
# LuCI 的 nginx 版（不声明与 uhttpd 冲突，两者共存安装；如首启 LuCI 端口冲突
# 可在设备上停用其一，或改用 -luci -uhttpd + luci-nginx 的整体替换方案）
luci-nginx=y

# === 监控 / 磁盘 / 系统 ===
luci-app-nlbwmon=n
luci-i18n-nlbwmon-zh-cn=n
luci-app-statistics=n
luci-i18n-statistics-zh-cn=n
luci-app-vnstat2=n
luci-i18n-vnstat2-zh-cn=n
luci-app-netdata=n
luci-i18n-netdata-zh-cn=n
luci-app-hd-idle=n
luci-i18n-hd-idle-zh-cn=n
luci-app-diskman=y
luci-i18n-diskman-zh-cn=y
luci-app-watchcat=n
luci-i18n-watchcat-zh-cn=n
luci-app-arpbind=n
luci-i18n-arpbind-zh-cn=n
luci-app-package-manager=n
luci-i18n-package-manager-zh-cn=n
luci-app-attendedsysupgrade=n
luci-i18n-attendedsysupgrade-zh-cn=n

# === 外设 / IoT / 实用 ===
luci-app-usb-printer=n
luci-i18n-usb-printer-zh-cn=n
luci-app-p910nd=n
luci-i18n-p910nd-zh-cn=n
luci-app-ser2net=n
luci-i18n-ser2net-zh-cn=n
luci-app-mjpg-streamer=n
luci-i18n-mjpg-streamer-zh-cn=n
luci-app-mosquitto=n
luci-i18n-mosquitto-zh-cn=n
luci-app-vlmcsd=n
luci-i18n-vlmcsd-zh-cn=n
luci-app-wol=n
luci-i18n-wol-zh-cn=n
luci-app-wechatpush=n
luci-i18n-wechatpush-zh-cn=n

# === 清单外的官方包（base/kmods 源提供，不在插件源中）===
kmod-mt7921u=y
wpad-openssl=y
openssh-sftp-server=y
