++		regmap_write(bsp_priv->grf, RK3528_VPU_GRF_GMAC_CON5, val);
++	} else {
++		val = enable ? RK3528_GMAC0_CLK_RMII_NOGATE :
++			       RK3528_GMAC0_CLK_RMII_GATE;
++		regmap_write(bsp_priv->grf, RK3528_VO_GRF_GMAC_CON, val);
